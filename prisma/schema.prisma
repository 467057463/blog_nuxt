// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  label    String     @unique
  order    Int
  parentId Int?
  parent   Category?  @relation("CageGoryList", fields: [parentId], references: [id])
  children Category[] @relation("CageGoryList")
  articles Article[]
  tags     Tag[]
}

model Tag {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  label      String    @unique
  articles   Article[]
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  role      Role      @default(USER)
  articles  Article[]
  profile   Profile?
}

model Profile {
  id        Int      @id @default(autoincrement())
  name      String
  avatar    String
  email     String?
  intro     String?
  site      String?
  github    String?
  phone     String?
  qq        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @unique
}

model Article {
  id         Int           @id @default(autoincrement())
  cover      String?
  title      String        @db.VarChar(1000)
  content    String        @db.Text
  describe   String?       @db.VarChar(1000)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  author     User          @relation(fields: [authorId], references: [id])
  authorId   Int
  tags       Tag[]
  categoryId Int?
  category   Category?     @relation(fields: [categoryId], references: [id])
  status     ArticleStatus @default(DARFT)
  // parentId   Int?
  darftId    Int?          @unique
  darft      Article?      @relation("articleDarft", fields: [darftId], references: [id])
  parent     Article?      @relation("articleDarft")
}

enum Role {
  USER
  ADMIN
}

enum ArticleStatus {
  DARFT
  OFFICIAL
}
